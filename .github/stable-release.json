{
  "name": "思绪 · Thinkly（uTools）",
  "branch": "main",
  "version_file": "package.json",
  "inputs": [
    "src",
    "public",
    "preload",
    "index.html",
    "quicknote.html",
    "plugin.json",
    "quicknote-plugin.json",
    "package.json",
    "bun.lock",
    "patches",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "vite.config.ts",
    "vite.debug.ts",
    "postcss.config.js",
    "scripts/utools-build.js",
    ".github/scripts/stable-release.py",
    ".github/stable-release.json",
    ".github/workflows/daily-stable.yml"
  ],
  "assets": [
    {
      "name": "goose-notes-utools-plugin.zip",
      "parts": [
        {
          "path": "dist"
        }
      ]
    },
    {
      "name": "goose-quicknote-utools-plugin.zip",
      "parts": [
        {
          "path": "dist-quicknote"
        }
      ]
    }
  ],
  "notes": "生产构建目录 ZIP：解压后可作为 uTools／ZTools 开发插件目录导入；这不是 .upx 安装包，也不会自动发布到插件商店。保留各插件已有 manifest 版本。常规笔记本与速记小窗分别打包，互不混入产物。"
}
